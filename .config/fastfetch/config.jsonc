{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "~/.local/share/fastfetch/images/hypr.png",
    "source": "/home/cristiansbardelotto/Pictures/Wallpapers/hinata.jpg",
    "type": "kitty",
    "height": 20,
    "width": 40,
    "padding": {
      "top": 2,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m ",
    },
    "break",
    {
      "type": "title",
      "keyWidth": 10,
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "37", // = color4
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "packages",
      "format": "{} (dnf)",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "cursor",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "terminalfont",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "datetime",
      "format": "{1}-{3}-{11}",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "media",
      "key": "󰝚 ",
      "keyColor": "37",
    },
    {
      "type": "player",
      "key": " ",
      "keyColor": "37",
    },
    {
      "type": "p",
      "key": " ",
      "keyColor": "37",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m  \u001b[37m ",
    },
    "break",
    "break",
  ],
}
